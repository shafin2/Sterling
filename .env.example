# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sterling
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=sterling

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Auth ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Public base URL used in share links embedded in emails and QR codes
APP_URL=http://localhost:3000

# ─── AWS S3 (file storage) ───────────────────────────────────
# On EC2 with IAM role attached: leave ACCESS_KEY and SECRET blank — SDK uses instance metadata.
# For local dev without IAM role: fill in access key + secret.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=sterling-app-512738511897

# ─── Email ───────────────────────────────────────────────────
# Local dev (Mailhog):
#   SMTP_HOST=localhost  SMTP_PORT=1025  (leave SMTP_SECURE blank)
#
# Gmail / Google Workspace:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=you@gmail.com   SMTP_PASS=<app-password>
#
# Port 465 (SSL — SendGrid, Mailgun, etc.):
#   SMTP_PORT=465  SMTP_SECURE=true
#
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# For Gmail: SMTP_FROM must be your Gmail address (Gmail ignores custom From addresses)
# For custom SMTP: can be any address, e.g. "Sterling <noreply@yourdomain.com>"
SMTP_FROM=noreply@sterling.app

# ─── Bull Board (queue dashboard) ────────────────────────────
# Set to a long random string in production (access via ?apiKey=... or X-Api-Key header).
# Leave blank in development to allow unauthenticated access.
BULL_BOARD_API_KEY=

# ─── Puppeteer (PDF generation) ──────────────────────────────
PUPPETEER_EXECUTABLE_PATH=
